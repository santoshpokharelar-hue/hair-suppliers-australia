# Postgres connection string from your Supabase project (Settings > Database).
DATABASE_URL=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Seeds one admin account when both are set (src/db/seed.ts). There is no
# public admin signup — this is the only way to create the first admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=orders@hairsuppliers.com.au

# Australia Post Postcode Search API (developers.auspost.com.au).
# Leave unset in local dev to use the mock fallback in src/lib/auspost.ts.
AUSPOST_API_KEY=

# This business's own ABN, shown on tax invoices issued to customers.
SELLER_ABN=
SELLER_BUSINESS_NAME="Hair Suppliers Australia"
