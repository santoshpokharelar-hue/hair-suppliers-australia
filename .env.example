# Postgres connection string from your Supabase project (Settings > Database).
DATABASE_URL=

# Supabase project URL + service role key (Settings > API) — used for product
# photo uploads via Supabase Storage, NOT for the database connection above.
# The service role key is secret; never expose it to the client. Leave unset
# and the admin product form will show "image uploads aren't configured yet"
# instead of crashing. The "product-images" bucket is created automatically
# on first upload — no manual dashboard step needed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Auth.js — generate with `npx auth secret`
AUTH_SECRET=

# Seeds an admin account when both are set (src/db/seed.ts), then re-run
# `npm run db:seed`. There is no public admin signup — this is the only way
# to create admin accounts. For more than one admin, add numbered pairs:
# ADMIN_EMAIL_2/ADMIN_PASSWORD_2, ADMIN_EMAIL_3/ADMIN_PASSWORD_3, etc.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_EMAIL_2=
# ADMIN_PASSWORD_2=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend
RESEND_API_KEY=
EMAIL_FROM=orders@hairsuppliers.com.au

# Base URL used to build absolute links in emails (pay link, admin dashboard
# link). Leave unset in local dev — falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# This business's own ABN, shown on tax invoices issued to customers.
SELLER_ABN=
SELLER_BUSINESS_NAME="Hair Suppliers Australia"
